# RETRAX - Git Ignore

# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# =========================
# Python / App Logs
# =========================
*.log
logs/

# =========================
# Local Databases
# =========================
*.db
*.sqlite
*.sqlite3
*.db-journal

# =========================
# Node / React
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build output
dist/
build/
.vite/

# =========================
# IDE
# =========================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

# =========================
# OS
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Temporary Files
# =========================
*.tmp
*.temp
*.bak
*.swp
*.swo

# =========================
# Test / Generated Output
# =========================
coverage/
test-results/
playwright-report/

# =========================
# Local Runtime
# =========================
.hindsight/
.runtime/